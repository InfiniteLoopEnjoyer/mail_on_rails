#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  # Reconcile the banned_ips file with the BannedIp table - the in-process
  # SMTP/IMAP listeners read it, and on a fresh volume it wouldn't exist
  # until the first ban commit otherwise. Best-effort: must not block boot.
  ./bin/rails mail_on_rails:banned_ips:sync || echo "banned_ips sync skipped"
fi

exec "${@}"
