/ Two-factor settings for the signed-in user's own account (enrollment lives
/ in the TwoFactor::Passkeys / TwoFactor::Totp controllers).
section.mt-6.max-w-lg.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.p-5
  h2.mb-1.text-sm.font-semibold Passkeys
  p.mb-4.text-sm.text-slate-500.dark:text-slate-400 Finish signing in with Touch ID, Windows Hello, or a hardware security key. Register more than one so a lost device doesn't lock you out.

  - passkeys = user.webauthn_credentials.order(:created_at)
  - if passkeys.any?
    ul.mb-4
      - passkeys.each do |passkey|
        li.mb-2.flex.items-baseline.gap-3.rounded-md.border.border-slate-200.dark:border-slate-800.px-4.py-2
          span.font-medium= passkey.nickname
          span.text-xs.whitespace-nowrap.text-slate-500.dark:text-slate-400= "added #{passkey.created_at.strftime("%b %-d, %Y")}"
          .ml-auto
            = button_to "Remove", two_factor_passkey_path(passkey), method: :delete, class: "inline-block cursor-pointer rounded-md border border-red-200 dark:border-red-900 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-red-700 dark:text-red-400", form: { data: { turbo_confirm: "Remove #{passkey.nickname}? You'll no longer be able to sign in with it." } }

  div data-controller="webauthn" data-webauthn-options-url-value=options_two_factor_passkeys_path data-webauthn-verify-url-value=two_factor_passkeys_path
    .flex.flex-wrap.items-center.gap-2
      input.rounded-md.border.border-slate-200.dark:border-slate-800.bg-slate-100.dark:bg-slate-800.px-2.5.py-1.5.text-sm type="text" placeholder="Name this passkey (e.g. YubiKey)" data-webauthn-target="nickname"
      button.inline-block.cursor-pointer.rounded-md.border.border-accent.bg-accent.px-3.5.py-1.text-sm.font-medium.text-white type="button" data-action="webauthn#register" Register passkey
    p.mt-2.text-sm.text-red-700.dark:text-red-400 hidden=true data-webauthn-target="error"

section.mt-6.max-w-lg.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.p-5
  h2.mb-1.text-sm.font-semibold Authenticator app
  p.mb-4.text-sm.text-slate-500.dark:text-slate-400 The fallback second factor: 6-digit codes from an authenticator app, for when no passkey is at hand.

  - if user.otp_enabled?
    .flex.items-center.gap-3
      span.rounded-full.bg-green-100.dark:bg-green-950.px-2.py-0.5.text-xs.text-green-700.dark:text-green-400 Enabled
      = button_to "Disable", two_factor_totp_path, method: :delete, class: "inline-block cursor-pointer rounded-md border border-red-200 dark:border-red-900 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-red-700 dark:text-red-400", form: { data: { turbo_confirm: "Disable authenticator-app codes? Your app's entry will stop working." } }
  - else
    = link_to "Set up authenticator app", new_two_factor_totp_path, class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
