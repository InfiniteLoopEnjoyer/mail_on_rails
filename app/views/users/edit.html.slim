- page_title "Edit #{@user.email_address}"

nav.mb-2.text-sm.text-slate-500.dark:text-slate-400
  =<> link_to "Users", users_path, class: "text-accent"
  | /
  span<>= @user.email_address

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold Edit User
  - confirm = @user == Current.user ? "Delete your own account? You will be signed out." : "Delete #{@user.email_address}?"
  / The controller refuses to delete the only remaining user; no button
  / for an action that can only fail.
  - if User.count > 1
    .flex.items-center.gap-2
      = button_to "Delete", user_path(@user), method: :delete, class: "inline-block cursor-pointer rounded-md border border-red-200 dark:border-red-900 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-red-700 dark:text-red-400", form: { data: { turbo_confirm: confirm } }

= render "form", user: @user

.mt-6.max-w-lg.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.p-5
  h2.mb-3.text-sm.font-semibold Password
  = render "shared/password_generator", url: generate_password_user_path(@user), password: flash[:generated_password]

/ Two-factor enrollment is self-service only (the TwoFactor controllers act
/ on Current.user), so the sections only appear on your own account.
- if @user == Current.user
  = render "appearance"
  = render "security", user: @user
