doctype html
html
  head
    title= content_for(:title) || "Mail on Rails"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Mail on Rails"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    / Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    / = tag.link rel: "manifest", href: pwa_manifest_path(format: :json)

    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/icon.png"

    / Includes all stylesheets in app/assets, including the Tailwind build
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  body.min-h-screen.bg-slate-100.text-slate-800
    - if authenticated?
      div data-controller="drawer" data-action="keydown.esc@window->drawer#close"
        / Mobile top bar - hamburger + brand; hidden on lg+
        header.sticky.top-0.z-20.flex.items-center.gap-3.border-b.border-slate-200.bg-slate-100.px-4.py-3.lg:hidden
          button.cursor-pointer.rounded-md.p-1.text-slate-600.hover:bg-slate-200 type="button" aria-label="Toggle navigation" data-action="drawer#toggle"
            svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
              path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"
          = link_to "Mail on Rails", root_path, class: "font-bold text-accent"
        / Backdrop for the mobile drawer
        .fixed.inset-0.z-30.hidden.bg-slate-900/50 data-drawer-target="backdrop" data-action="click->drawer#close"
        = render "layouts/sidebar"
        main.lg:pl-64
          .mx-auto.max-w-4xl.px-4.pt-6.pb-16
            = render "shared/flash"
            = yield
    - else
      main.mx-auto.max-w-4xl.px-4.pt-6.pb-16
        = yield

    = console if Rails.env.development?
    