- method = local_assigns.fetch(:method, :post)
- password = local_assigns.fetch(:password, nil)
- signin_link = local_assigns.fetch(:signin_link, false)

#password-generator
  - if password.present?
    = render "shared/generated_password", password: password
    - if signin_link
      p.mt-4
        = link_to "Continue to sign in", new_session_path, class: "text-accent"
  - else
    = button_to "Generate password", url, method: method, class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
    p.mt-2.text-xs.text-slate-500.dark:text-slate-400 Replaces the current password with a random one, shown exactly once.
