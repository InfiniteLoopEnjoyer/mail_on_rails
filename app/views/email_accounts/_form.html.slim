= form_with model: email_account, class: "max-w-lg rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5" do |form|
  - if email_account.errors.any?
    .mb-4.rounded-md.bg-red-100.dark:bg-red-950.px-3.py-2.text-sm.text-red-700.dark:text-red-400
      ul.list-disc.pl-4
        - email_account.errors.full_messages.each do |message|
          li= message

  .mb-4
    = form.label :email, class: "mb-1 block text-sm font-semibold"
    = form.email_field :email, required: true, autofocus: email_account.new_record?, class: "w-full rounded-md border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 px-2.5 py-1.5"

  .mb-4
    = form.label :name, "Display name", class: "mb-1 block text-sm font-semibold"
    = form.text_field :name, class: "w-full rounded-md border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 px-2.5 py-1.5"

  - if email_account.new_record?
    p.mb-4.text-xs.text-slate-500.dark:text-slate-400 A password will be generated when the account is created.

  .mt-5
    = form.submit class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
