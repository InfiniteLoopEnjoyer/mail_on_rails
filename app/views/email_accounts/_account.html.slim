li.mb-2.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
  = link_to email_account_path(account), class: "flex items-baseline gap-3 px-4 py-3" do
    span.primary.font-semibold= account.email
    span.truncate.text-slate-500.dark:text-slate-400= account.name
    - if (unseen = @unseen_counts[account.id].to_i).positive?
      span.rounded-full.bg-accent.px-2.text-xs.whitespace-nowrap.text-white= "#{unseen} unread"
    span.ml-auto.text-xs.whitespace-nowrap.text-slate-500.dark:text-slate-400= pluralize(account.mailboxes.size, "folder")
