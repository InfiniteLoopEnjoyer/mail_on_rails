- page_title "New email"

header.mb-4
  h1.text-2xl.font-bold New email

= form_with model: @composed_email, url: emails_path, class: "max-w-2xl rounded-lg border border-slate-200 bg-white p-5" do |form|
  - if @composed_email.errors.any?
    .mb-4.rounded-md.bg-red-100.px-3.py-2.text-sm.text-red-700
      ul.list-disc.pl-4
        - @composed_email.errors.full_messages.each do |message|
          li= message

  .mb-4
    = form.label :email_account_id, "From", class: "mb-1 block text-sm font-semibold"
    = form.collection_select :email_account_id, @email_accounts, :id, :email, {}, class: "w-full rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1.5"

  .mb-4
    = form.label :to, class: "mb-1 block text-sm font-semibold"
    = form.text_field :to, required: true, placeholder: "one@example.com, two@example.org", class: "w-full rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1.5"

  .mb-4
    = form.label :subject, class: "mb-1 block text-sm font-semibold"
    = form.text_field :subject, required: true, class: "w-full rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1.5"

  .mb-4
    = form.label :body, "Message", class: "mb-1 block text-sm font-semibold"
    = form.text_area :body, rows: 12, class: "w-full rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1.5"

  .mt-5
    = form.submit "Send", class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
