- page_title "#{@mailbox.name}"

= turbo_stream_from @mailbox

nav.mb-2.text-sm.text-slate-500.dark:text-slate-400
  =<> link_to "Accounts", root_path, class: "text-accent"
  | /
  =<> link_to @email_account.email, email_account_path(@email_account), class: "text-accent"
  | /
  span<>= @mailbox.name

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold= @mailbox.name
  .flex.items-center.gap-2
    / Import: the file input stays hidden; picking files submits the form,
    / so the label is the whole UI. Styled to match the buttons beside it.
    = form_with url: import_email_account_mailbox_path(@email_account, @mailbox), method: :post, multipart: true, class: "contents", data: { controller: "form" } do
      label.inline-block.cursor-pointer.rounded-md.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-3.5.py-1.text-sm.font-medium.text-slate-800.dark:text-slate-100 for="mailbox_import_eml"
        | Import .eml
        input#mailbox_import_eml.sr-only type="file" name="eml[]" accept=".eml,message/rfc822" multiple=true data-action="change->form#submit"
    / data-turbo=false: a file download, not a navigation.
    = link_to "Export mbox", export_email_account_mailbox_path(@email_account, @mailbox), class: "inline-block cursor-pointer rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-slate-800 dark:text-slate-100", data: { turbo: false }
    - unless @mailbox.inbox?
      = link_to "Edit", edit_email_account_mailbox_path(@email_account, @mailbox), class: "inline-block cursor-pointer rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-slate-800 dark:text-slate-100"
      = button_to "Delete", email_account_mailbox_path(@email_account, @mailbox), method: :delete, class: "inline-block cursor-pointer rounded-md border border-red-200 dark:border-red-900 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-red-700 dark:text-red-400", form: { data: { turbo_confirm: "Delete the #{@mailbox.name} folder and all messages in it?" } }

- if @threads.any?
  ul
    - @threads.each do |thread|
      = render "email_messages/row", message: thread.latest, email_account: @email_account, mailbox: @mailbox, thread_count: thread.count, unseen: thread.unseen?
  = render "shared/pagination", page: @page, pages: @pages, count: @message_count, url: ->(page) { email_account_mailbox_path(@email_account, @mailbox, page: page) }
- else
  p.text-slate-500.dark:text-slate-400 This folder is empty.
