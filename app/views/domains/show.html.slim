- content_for :title, "Rail Mail - #{@domain.name}"
- dkim = @domain.dkim_key
- mail_host = ENV["SMTP_HELO_HOST"].presence || "<your mail host>"

nav.mb-2.text-sm.text-slate-500
  =<> link_to "Domains", domains_path, class: "text-accent"
  | /
  span<>= @domain.name

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold= @domain.name
  .flex.items-center.gap-2
    - if CloudflareDns.enabled?
      = button_to "Publish DNS to Cloudflare", publish_dns_domain_path(@domain), class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white", form: { data: { turbo_confirm: "Create #{@domain.name}'s missing DNS records in Cloudflare? Existing MX/SPF/DMARC records are never overwritten; only a mismatched DKIM TXT is updated." } }
    = button_to "Delete", domain_path(@domain), method: :delete, class: "inline-block cursor-pointer rounded-md border border-red-200 bg-white px-3.5 py-1 text-sm font-medium text-red-700", form: { data: { turbo_confirm: "Remove #{@domain.name}? Exim will immediately refuse inbound mail for it and outbound mail stops being DKIM-signed." } }

.mb-4.flex.flex-wrap.gap-2
  - if dkim.present?
    span.rounded-full.bg-green-100.px-2.py-0.5.text-xs.text-green-700 DKIM key present
  - else
    span.rounded-full.bg-yellow-100.px-2.py-0.5.text-xs.text-yellow-700 DKIM key missing (outbound goes unsigned)
  - if @domain.synced_to_exim?
    span.rounded-full.bg-green-100.px-2.py-0.5.text-xs.text-green-700 listed in exim - accepting mail
  - else
    span.rounded-full.bg-red-100.px-2.py-0.5.text-xs.text-red-700 not in exim's domain list (sync pending?)

h2.mb-2.text-lg.font-semibold DNS records to publish
p.mb-3.text-sm.text-slate-500
  ' Mail for this domain only flows once these records exist (and
  =<> link_to "accounts", root_path, class: "text-accent"
  ' with @#{@domain.name} addresses are created). Status is checked live
  ' against public DNS on each page load.

- dns_status = @dns.checks.index_by(&:record)
- status_badges = { pass: [ "published", "bg-green-100 text-green-700" ], warn: [ "verify", "bg-yellow-100 text-yellow-700" ], fail: [ "missing/wrong", "bg-red-100 text-red-700" ], unknown: [ "unknown", "bg-slate-200 text-slate-600" ] }
.mb-4.overflow-x-auto.rounded-lg.border.border-slate-200.bg-white
  table.w-full.text-left.text-sm
    thead
      tr.border-b.border-slate-200.text-xs.text-slate-500
        th.px-4.py-2 Type
        th.px-4.py-2 Name
        th.px-4.py-2 Value
        th.px-4.py-2 Status
    tbody
      - rows = [ [ "MX", "MX", @domain.name, "10 #{mail_host}." ], [ "TXT (SPF)", "SPF", @domain.name, "v=spf1 mx -all" ], [ "TXT (DKIM)", "DKIM", dkim.txt_name, nil ], [ "TXT (DMARC)", "DMARC", "_dmarc.#{@domain.name}", "v=DMARC1; p=none; rua=mailto:#{@domain.dmarc_address}" ] ]
      - rows.each do |label, key, record_name, value|
        - c = dns_status[key]
        tr.border-b.border-slate-100
          td.px-4.py-2.font-semibold= label
          td.px-4.py-2: code= record_name
          td.px-4.py-2
            - if key == "DKIM"
              - if dkim.present?
                code.break-all= dkim.txt_value
              - else
                span.text-slate-500 (no key on this server)
            - else
              code= value
          td.px-4.py-2
            - badge_text, badge_class = status_badges[c.status]
            span.rounded-full.px-2.py-0.5.text-xs.whitespace-nowrap class=badge_class
              = badge_text
            - if c.note
              p.mt-1.text-xs.text-slate-500= c.note
            - elsif c.found && c.status == :pass && key != "DMARC"
              p.mt-1.text-xs.break-all.text-slate-500= c.found

p.mb-6.text-xs.text-slate-500
  ' Start with p=none; the monitoring section below tells you when it is
  ' safe to tighten. DKIM selector:
  code<>= dkim.selector
  ' . Aggregate reports are delivered to
  code<>= @domain.dmarc_address
  '  (auto-created) and parsed automatically.

h2.mb-2.text-lg.font-semibold DMARC monitoring
- advice_key, advice_text = @dmarc_advice
- advice_colors = { publish: "bg-yellow-100 text-yellow-700", waiting: "bg-slate-200 text-slate-600",
                    monitoring: "bg-yellow-100 text-yellow-700", ready: "bg-green-100 text-green-700",
                    done: "bg-green-100 text-green-700" }
.mb-4.rounded-lg.border.border-slate-200.bg-white.p-4
  .mb-2.flex.flex-wrap.items-center.gap-2
    span.rounded-full.px-2.py-0.5.text-xs class=advice_colors[advice_key]
      = advice_key.to_s.tr("_", " ")
    - if @dns.dmarc_record
      code.text-xs.text-slate-500= @dns.dmarc_record
    - else
      span.text-xs.text-slate-500 no _dmarc record found in DNS
  p.text-sm= advice_text
  - if @dmarc_stats[:total].positive?
    .mt-3.flex.flex-wrap.gap-x-6.gap-y-1.text-sm.text-slate-600
      span
        strong= @dmarc_stats[:total]
        '  messages / 30 days
      span
        strong= "#{@dmarc_stats[:aligned_pct].round(1)}%"
        '  aligned
      span
        strong= @dmarc_stats[:sources]
        '  source IPs
      span
        strong= @dmarc_stats[:reporters]
        '  reporters
    - if @dmarc_stats[:failing].any?
      .mt-2.text-sm.text-red-700
        ' Failing sources (investigate before tightening):
        - @dmarc_stats[:failing].sort_by { |_, n| -n }.first(10).each do |ip, count|
          code.mr-2= "#{ip} (#{count})"
