- page_title "Domains"

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold Domains
  .flex.items-center.gap-2
    = link_to "New domain", new_domain_path, class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"

- if @domains.any?
  ul
    - @domains.each do |domain|
      li.mb-2.rounded-lg.border.border-slate-200.bg-white
        = link_to domain_path(domain), class: "flex items-baseline gap-3 px-4 py-3" do
          span.primary.font-semibold= domain.name
          .ml-auto.flex.gap-2
            - if domain.dkim_private_key.present?
              span.rounded-full.bg-green-100.px-2.text-xs.whitespace-nowrap.text-green-700 DKIM key
            - else
              span.rounded-full.bg-yellow-100.px-2.text-xs.whitespace-nowrap.text-yellow-700 no DKIM key
            - if domain.synced_to_exim?
              span.rounded-full.bg-green-100.px-2.text-xs.whitespace-nowrap.text-green-700 exim: listed
            - else
              span.rounded-full.bg-red-100.px-2.text-xs.whitespace-nowrap.text-red-700 exim: not listed
- else
  p.text-slate-500
    ' No domains yet. Add the domains you host mail for - exim picks up
    ' changes live, and each domain gets a DKIM signing key.
