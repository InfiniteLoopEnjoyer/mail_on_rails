- page_title "Audit log"

header.mb-4
  h1.text-2xl.font-bold Audit log
  p.mt-1.text-sm.text-slate-500.dark:text-slate-400 Every admin action: who did what to what, from where. Rows are immutable and kept forever.

- if @audit_events.any?
  .overflow-x-auto.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
    table.w-full.text-left.text-sm
      thead.border-b.border-slate-200.dark:border-slate-800.text-xs.text-slate-500.dark:text-slate-400
        tr
          th.px-4.py-2 When
          th.px-4.py-2 User
          th.px-4.py-2 Action
          th.px-4.py-2 Subject
          th.px-4.py-2 Details
          th.px-4.py-2 IP
      tbody
        - @audit_events.each do |event|
          tr.border-b.border-slate-100.dark:border-slate-800.last:border-0
            td.px-4.py-2.whitespace-nowrap.text-slate-500.dark:text-slate-400 title=event.created_at.iso8601
              = "#{time_ago_in_words(event.created_at)} ago"
            td.px-4.py-2.whitespace-nowrap= event.user_email
            td.px-4.py-2.whitespace-nowrap
              code.rounded.bg-slate-100.dark:bg-slate-800.px-1.5.py-0.5.text-xs= event.action
            td.px-4.py-2= event.subject_label
            td.px-4.py-2.text-xs.text-slate-500.dark:text-slate-400
              - event.details.each do |key, value|
                div= "#{key}: #{Array(value).join(", ")}"
            td.px-4.py-2.whitespace-nowrap.text-slate-500.dark:text-slate-400= event.ip
  = render "shared/pagination", page: @page, pages: @pages, count: @count, noun: "events", url: ->(page) { audit_events_path(page: page) }
- else
  p.text-slate-500.dark:text-slate-400 Nothing recorded yet. Admin actions (users, accounts, aliases, domains, bans, settings) will appear here.
