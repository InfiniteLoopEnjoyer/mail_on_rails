- page_title "Two-factor verification"

.mx-auto.mt-16.max-w-md
  h1.mb-4.text-2xl.font-bold Two-factor verification

  = render "shared/flash"

  - if @user.webauthn_credentials.exists?
    .mb-4.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.p-5 data-controller="webauthn" data-webauthn-options-url-value=webauthn_options_two_factor_challenge_path data-webauthn-verify-url-value=webauthn_two_factor_challenge_path
      p.mb-3.text-sm.text-slate-600.dark:text-slate-300 Use your passkey to finish signing in.
      button.inline-block.cursor-pointer.rounded-md.border.border-accent.bg-accent.px-3.5.py-1.text-sm.font-medium.text-white type="button" data-action="webauthn#authenticate" Use passkey
      p.mt-2.text-sm.text-red-700.dark:text-red-400 hidden=true data-webauthn-target="error"

  - if @user.otp_enabled?
    .rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.p-5
      = form_with url: totp_two_factor_challenge_path do |form|
        p.mb-3.text-sm.text-slate-600.dark:text-slate-300 Or enter the 6-digit code from your authenticator app.
        .mb-4
          = form.text_field :code, required: true, autofocus: !@user.webauthn_credentials.exists?, autocomplete: "one-time-code", inputmode: "numeric", maxlength: 7, placeholder: "123 456", class: "w-full rounded-md border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 px-2.5 py-1.5"
        = form.submit "Verify", class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
