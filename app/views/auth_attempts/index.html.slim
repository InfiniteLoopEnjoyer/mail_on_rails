- page_title "Auth attempts"

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold Auth attempts

  nav.flex.items-center.gap-1
    - AuthAttemptsController::WINDOWS.each_key do |key|
      = link_to key, auth_attempts_path(window: key), class: window_tab_classes(@window == key)

p.mb-4.text-sm.text-slate-500.dark:text-slate-400
  ' Failed credential checks from all three auth surfaces. Passwords are
  ' never recorded - most failures are real people mistyping, so the column
  ' would fill with working credentials for these very mailboxes.

section.mb-5.grid.gap-3 class="sm:grid-cols-2 lg:grid-cols-4"
  - [["Attempts", @totals[:attempts]], ["Source addresses", @totals[:sources]], ["Addresses tried", @totals[:usernames]], ["Against real accounts", @totals[:real_accounts]]].each do |label, value|
    .rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-4.py-3
      .text-xs.text-slate-500.dark:text-slate-400= label
      .text-2xl.font-bold class=(label == "Against real accounts" && value.to_i.positive? ? "text-red-700 dark:text-red-400" : "")
        = number_with_delimiter(value)

- if @targeted.any?
  section.mb-5.rounded-lg.border.border-red-200.dark:border-red-900.bg-red-50.dark:bg-red-950.px-4.py-3
    h2.mb-1.font-semibold.text-red-800.dark:text-red-300 Real addresses under attempt
    p.mb-3.text-sm.text-red-700.dark:text-red-400
      ' These exist here. Everything else on this page is someone reciting a
      ' dictionary at the internet; this is someone who looked first.
    dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 text-sm"
      - @targeted.each do |username, count|
        dt.font-mono.text-red-900.dark:text-red-200= username
        dd.text-right.tabular-nums.text-red-800.dark:text-red-300= number_with_delimiter(count)

.grid.gap-4 class="lg:grid-cols-2"
  section.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
    header.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
      h2.font-semibold Source ranges
      p.text-sm.text-slate-500.dark:text-slate-400
        ' IPv4 sources grouped into /24s - a spray reads as noise one address
        ' at a time and as one campaign together.
    - if @ranges.any?
      table.w-full.text-sm
        tbody
          - @ranges.each do |range, count|
            tr.border-t.border-slate-100.dark:border-slate-800
              td.px-4.py-1.5.font-mono
                = link_to range, range_auth_attempts_path(cidr: range, window: @window), class: "hover:text-accent hover:underline"
              td.px-4.py-1.5.text-right.tabular-nums.text-slate-600.dark:text-slate-300= number_with_delimiter(count)
              td.px-4.py-1.5.text-right
                = render "ban_button", target: range, confirm: "Ban the whole range #{range}? Every address in it loses SMTP, IMAP and web login access."
    - else
      p.px-4.py-3.text-sm.text-slate-500.dark:text-slate-400 Nothing in this window.

  section.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
    header.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
      h2.font-semibold Addresses tried
      p.text-sm.text-slate-500.dark:text-slate-400 What the dictionary is made of.
    - if @usernames.any?
      table.w-full.text-sm
        tbody
          - @usernames.each do |username, count|
            tr.border-t.border-slate-100.dark:border-slate-800
              td.px-4.py-1.5.font-mono class=(@targeted.key?(username) ? "text-red-700 dark:text-red-400 font-semibold" : "")
                = username
              td.px-4.py-1.5.text-right.tabular-nums.text-slate-600.dark:text-slate-300= number_with_delimiter(count)
    - else
      p.px-4.py-3.text-sm.text-slate-500.dark:text-slate-400 Nothing in this window.

- if @recent_real.any?
  section.mt-4.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
    header.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
      h2.font-semibold Most recent attempts on real addresses
    .overflow-x-auto
      table.w-full.text-sm
        thead.text-left.text-xs.text-slate-500.dark:text-slate-400
          tr
            th.px-4.py-2 When
            th.px-4.py-2 Address
            th.px-4.py-2 From
            th.px-4.py-2 Surface
            th.px-4.py-2 Outcome
            th.px-4.py-2
        tbody
          - @recent_real.each do |attempt|
            tr.border-t.border-slate-100.dark:border-slate-800
              td.px-4.py-1.5.whitespace-nowrap.text-slate-600.dark:text-slate-300= attempt.occurred_at.strftime("%b %-d %H:%M")
              td.px-4.py-1.5.font-mono= attempt.username
              td.px-4.py-1.5.font-mono.text-slate-600.dark:text-slate-300= attempt.ip
              td.px-4.py-1.5.text-slate-600.dark:text-slate-300= attempt.source
              td.px-4.py-1.5.text-slate-600.dark:text-slate-300= attempt.outcome.tr("_", " ")
              td.px-4.py-1.5.text-right
                - if attempt.ip.present?
                  = render "ban_button", target: attempt.ip, confirm: "Ban #{attempt.ip}? It loses SMTP, IMAP and web login access."

section.mt-4.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
  header.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
    h2.font-semibold Banned IPs
    p.text-sm.text-slate-500.dark:text-slate-400
      ' Permanent bans, enforced everywhere at once: exim drops the
      ' connection before its banner, the IMAP daemon before its greeting,
      ' and the web login refuses to look at credentials. AuthThrottle's
      ' automatic blocks expire; these stay until removed here.
  .px-4.py-3
    = form_with url: banned_ips_path, scope: :banned_ip, method: :post do |form|
      = hidden_field_tag :window, @window
      .flex.flex-wrap.items-center.gap-2
        = form.text_field :cidr, placeholder: "203.0.113.0/24", required: true,
                          class: "w-44 rounded-md border border-slate-300 dark:border-slate-600 px-2 py-1 font-mono text-sm"
        = form.text_field :note, placeholder: "note (optional)",
                          class: "w-64 rounded-md border border-slate-300 dark:border-slate-600 px-2 py-1 text-sm"
        = form.submit "Ban", class: "cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
  - if @manual_bans.any?
    table.w-full.text-sm
      thead.text-left.text-xs.text-slate-500.dark:text-slate-400
        tr
          th.px-4.py-2 Range
          th.px-4.py-2 Note
          th.px-4.py-2 Since
          th.px-4.py-2
      tbody
        - @manual_bans.each do |ban|
          tr.border-t.border-slate-100.dark:border-slate-800
            td.px-4.py-1.5.font-mono= ban.cidr
            td.px-4.py-1.5.text-slate-600.dark:text-slate-300= ban.note
            td.px-4.py-1.5.whitespace-nowrap.text-slate-600.dark:text-slate-300= ban.created_at.strftime("%b %-d")
            td.px-4.py-1.5.text-right
              = button_to "Unban", banned_ip_path(ban, window: @window), method: :delete,
                  class: "inline-block cursor-pointer rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300",
                  form: { data: { turbo_confirm: "Unban #{ban.cidr}? Its connections are accepted again immediately." }, class: "inline-block" }
  - else
    p.border-t.border-slate-100.dark:border-slate-800.px-4.py-3.text-sm.text-slate-500.dark:text-slate-400 No manual bans.
  - if @drop_bans.positive?
    p.border-t.border-slate-100.dark:border-slate-800.px-4.py-2.text-xs.text-slate-500.dark:text-slate-400
      = "+ #{pluralize(number_with_delimiter(@drop_bans), "range")} from the Spamhaus DROP list"
      - if @drop_refreshed_at
        = ", refreshed #{time_ago_in_words(@drop_refreshed_at)} ago"
      ' . Refreshed daily; not removable here because the next refresh would restore them.

- if @totals[:collapsed].to_i.positive?
  p.mt-4.text-xs.text-slate-500.dark:text-slate-400
    = "#{number_with_delimiter(@totals[:collapsed])} attempts in this window are counted but not listed individually: "
    ' past a per-address cap, dictionary noise is collapsed into one row per
    ' source and hour so an attacker cannot set the size of this table.
    ' Attempts on real addresses are never collapsed.
