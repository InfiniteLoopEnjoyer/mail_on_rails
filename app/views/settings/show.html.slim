- page_title "Settings"

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold Settings

h2.mb-2.text-lg.font-semibold SMTP hostname
section.mb-6.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-4.py-3
  p.mb-3.text-sm.text-slate-500.dark:text-slate-400
    ' The name this server announces on SMTP connections (the 220 banner
    ' and HELO/EHLO replies) and sends as its own HELO when delivering
    ' outbound mail. Receiving servers compare it against this machine's
    ' public DNS, so it should be the mail host's FQDN. Applies to new
    ' connections immediately. Leave blank to fall back to
    code.rounded.bg-slate-100.dark:bg-slate-800.px-1 SMTP_HELO_HOST
    ' , then the system hostname.
  = form_with url: settings_path, method: :patch do |form|
    .flex.flex-wrap.items-center.gap-2
      = form.text_field :smtp_helo_hostname, value: @smtp_helo_hostname, placeholder: @effective_smtp_helo_hostname,
                        class: "w-72 rounded-md border border-slate-300 dark:border-slate-600 px-2 py-1 text-sm font-mono"
      = form.submit "Save", class: "cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
  p.mt-2.text-xs.text-slate-500.dark:text-slate-400
    ' Currently announcing
    code.rounded.bg-slate-100.dark:bg-slate-800.px-1<>= @effective_smtp_helo_hostname
    = "(from #{@smtp_helo_hostname_source})."

h2.mb-2.text-lg.font-semibold Trash retention
section.mb-6.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-4.py-3
  p.mb-3.text-sm.text-slate-500.dark:text-slate-400
    ' Messages in Trash are deleted permanently after this many days,
    ' counted from the day they were moved to Trash (not the day they were
    ' received). Mail in every other folder is kept forever.
  = form_with url: settings_path, method: :patch do |form|
    .flex.flex-wrap.items-center.gap-2
      = form.number_field :trash_retention_days, value: @trash_retention_days, min: 1, step: 1, required: true,
                          class: "w-24 rounded-md border border-slate-300 dark:border-slate-600 px-2 py-1 text-sm"
      span.text-sm.text-slate-500.dark:text-slate-400 days
      = form.submit "Save", class: "cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"

h2.mb-2.text-lg.font-semibold Mail listener files
p.mb-3.text-sm.text-slate-500.dark:text-slate-400
  ' Files this app writes for its in-process mail listeners, shown exactly
  ' as the listeners read them (mtime-polled, no restart). Drift against
  ' the database means a sync was skipped or failed - reconcile with the
  ' file's Sync button (or
  code.rounded.bg-slate-100.dark:bg-slate-800.px-1 bin/rails mail_on_rails:banned_ips:sync
  ' ).

- @synced_files.each do |file|
  section.mb-4.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
    header.flex.flex-wrap.items-center.gap-2.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
      h3.flex.flex-row.gap-2
        span.font-semibold
          = file.label

        - if !file.configured?
          span.rounded-full.bg-slate-200.dark:bg-slate-700.px-2.py-0.5.text-xs.text-slate-600.dark:text-slate-300.flex.items-center.justify-center
            = "#{file.env_var} not set"
        - elsif !file.exists?
          span.rounded-full.bg-red-100.dark:bg-red-950.px-2.py-0.5.text-xs.text-red-700.dark:text-red-400.flex.items-center.justify-center File missing - no bans enforced
        - elsif file.in_sync?
          span.rounded-full.bg-green-100.dark:bg-green-950.px-2.py-0.5.text-xs.text-green-700.dark:text-green-400.flex.items-center.justify-center Synced
        - else
          span.rounded-full.bg-red-100.dark:bg-red-950.px-2.py-0.5.text-xs.text-red-700.dark:text-red-400.flex.items-center.justify-center Diverged
      
      .ml-auto.flex.flex-wrap.items-center.gap-2
        
        - if file.configured?
          = button_to "Sync now", sync_settings_path(file: file.key), class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
        
    .px-4.py-3
      
      p.mb-3.text-sm.text-slate-500.dark:text-slate-400= file.description
      
      - if file.configured?
        dl class="mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm"
          dt.text-slate-500.dark:text-slate-400 Path
          dd.font-mono.text-xs.leading-5= file.path
          - if file.mtime
            dt.text-slate-500.dark:text-slate-400 Last written
            dd
              = "#{time_ago_in_words(file.mtime)} ago"
              span.text-slate-400.dark:text-slate-500<= file.mtime.utc.strftime(" (%Y-%m-%d %H:%M UTC)")
        - if file.exists?
          
          - if file.lines.any?
            pre.overflow-x-auto.rounded-md.bg-slate-50.dark:bg-slate-800.p-3.font-mono.text-xs.leading-5= file.lines.join("\n")
          - else
            p.text-sm.text-slate-500.dark:text-slate-400 The file is empty - no bans in effect.

          - if file.missing.any?
            p.mt-2.text-sm.text-red-700.dark:text-red-400
              strong In the database but not the file (not yet enforced):
              =<  file.missing.join(", ")
          - if file.stale.any?
            p.mt-2.text-sm.text-red-700.dark:text-red-400
              strong In the file but not the database (still enforced):
              =<  file.stale.join(", ")
      - else
        p.text-sm.text-slate-500.dark:text-slate-400
          ' Not configured in this environment - set
          code.rounded.bg-slate-100.dark:bg-slate-800.px-1<>= file.env_var
          ' to the file's path on the shared volume to enable syncing.
