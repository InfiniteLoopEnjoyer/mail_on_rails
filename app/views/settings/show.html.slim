- page_title "Settings"

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold Settings

h2.mb-2.text-lg.font-semibold Exim edge files
p.mb-3.text-sm.text-slate-500
  ' These are the files this app writes on the mailconf volume shared with
  ' the exim container, shown exactly as exim reads them (re-read per
  ' connection, no restart). Drift against the database means a sync was
  ' skipped or failed - reconcile with each file's Sync button (or
  code.rounded.bg-slate-100.px-1 bin/rails mail_on_rails:domains:sync
  '  /
  code.rounded.bg-slate-100.px-1 bin/rails mail_on_rails:recipients:sync
  ' ).

- @exim_files.each do |file|
  section.mb-4.rounded-lg.border.border-slate-200.bg-white
    header.flex.flex-wrap.items-center.gap-2.border-b.border-slate-200.px-4.py-3
      h3.flex.flex-row.gap-2
        span.font-semibold
          = file.label

        - if !file.configured?
          span.rounded-full.bg-slate-200.px-2.py-0.5.text-xs.text-slate-600.flex.items-center.justify-center
            = "#{file.env_var} not set"
        - elsif !file.exists?
          span.rounded-full.bg-red-100.px-2.py-0.5.text-xs.text-red-700.flex.items-center.justify-center File missing - exim defers all inbound
        - elsif file.in_sync?
          span.rounded-full.bg-green-100.px-2.py-0.5.text-xs.text-green-700.flex.items-center.justify-center Synced
        - else
          span.rounded-full.bg-red-100.px-2.py-0.5.text-xs.text-red-700.flex.items-center.justify-center Diverged
      
      .ml-auto.flex.flex-wrap.items-center.gap-2
        
        - if file.configured?
          = button_to "Sync now", sync_settings_path(file: file.key), class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
        
    .px-4.py-3
      
      p.mb-3.text-sm.text-slate-500= file.description
      
      - if file.configured?
        dl class="mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm"
          dt.text-slate-500 Path
          dd.font-mono.text-xs.leading-5= file.path
          - if file.mtime
            dt.text-slate-500 Last written
            dd
              = "#{time_ago_in_words(file.mtime)} ago"
              span.text-slate-400<= file.mtime.utc.strftime(" (%Y-%m-%d %H:%M UTC)")
        - if file.exists?
          
          - if file.lines.any?
            pre.overflow-x-auto.rounded-md.bg-slate-50.p-3.font-mono.text-xs.leading-5= file.lines.join("\n")
          - else
            p.text-sm.text-amber-700 The file is empty - exim answers 550 for every entry it would otherwise match.
          
          - if file.missing.any?
            p.mt-2.text-sm.text-red-700
              strong In the database but not the file (exim rejects these):
              =<  file.missing.join(", ")
          - if file.stale.any?
            p.mt-2.text-sm.text-red-700
              strong In the file but not the database (exim still accepts these):
              =<  file.stale.join(", ")
      - else
        p.text-sm.text-slate-500
          ' Not configured in this environment - set
          code.rounded.bg-slate-100.px-1<>= file.env_var
          ' to the file's path on the shared volume to enable syncing.
