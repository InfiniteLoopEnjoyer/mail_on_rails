- page_title "Update Password"

.mx-auto.mt-16.max-w-md
  h1.mb-4.text-2xl.font-bold Update your password

  = render "shared/flash"

  .rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.p-5
    = render "shared/password_generator", url: password_path(params[:token]), method: :put, password: @generated_password, signin_link: true
